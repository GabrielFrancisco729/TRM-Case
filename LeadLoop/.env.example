# The local login is DEMO ONLY. AD selection is not authenticated.
MANAGER_DEMO_PIN=quillon-demo
SESSION_SECRET=replace-with-random-secret-for-local-demo
# Slack. Leave blank to simulate delivery; define channel IDs for live Slack use.
SLACK_BOT_TOKEN=
SLACK_CHANNELS_JSON={"NA":"C_REPLACE","EMEA":"C_REPLACE","APAC":"C_REPLACE","LATAM":"C_REPLACE","UNASSIGNED":"C_REPLACE"}
# Salesforce. Integration is a scaffold; no writes are enabled by default.
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=
SF_API_VERSION=v61.0
SF_WRITEBACK_ENABLED=false

# Optional, human-triggered AI advisory drafts. Copy this file to .env and set both.
# Example Claude API model ID: claude-sonnet-4-6 (verify access in Anthropic Console).
# Configuring these explicitly opts into sending minimized structured lead attributes
# to your selected AI provider when a Manager or AD explicitly requests an AI suggestion.
ANTHROPIC_API_KEY=
LEADLOOP_LLM_MODEL=

# Optional public demonstration access gate (HTTP Basic Auth)
# Use a unique password and share it separately with the panel.
LEADLOOP_SITE_USER=reviewer
LEADLOOP_SITE_PASSWORD=
LEADLOOP_SECURE_COOKIES=false
# Optional paid Render persistent disk directory (e.g. /var/data)
LEADLOOP_STATE_DIR=
